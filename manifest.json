{
  "type": "plugin",
  "id": "com.dujin.edgeever-social-graph",
  "name": "人际关系图谱",
  "version": "1.0.0",
  "apiVersion": "2",
  "settingsUi": "host",
  "description": "把「人际关系」笔记本变成一张可交互的关系图谱：记录人物、关系强度与互动历史，支持密码加密存储。",
  "entry": "./main.js",
  "platforms": ["web", "desktop"],
  "permissions": ["notes:read", "notes:write", "ui:commands", "ui:notices", "ui:panels"],
  "settings": {
    "fields": [
      {
        "key": "notebookName",
        "type": "text",
        "label": "数据笔记本名称",
        "default": "人际关系",
        "required": true
      },
      {
        "key": "vaultNoteTitle",
        "type": "text",
        "label": "加密模式数据笔记标题",
        "default": "人际关系数据",
        "required": true
      },
      {
        "key": "groups",
        "type": "text",
        "label": "圈层分类（逗号分隔）",
        "default": "家人,同事,朋友,客户,网友,其他",
        "required": true
      }
    ]
  }
}
